{
  "name": "geopulse-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "audit:critical": "npm audit --omit=dev --audit-level=critical",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@kepler.gl/actions": "3.2.6",
    "@kepler.gl/components": "3.2.6",
    "@kepler.gl/reducers": "3.2.6",
    "mapbox-gl": "1.13.1",
    "maplibre-gl": "6.11.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "8.1.3",
    "redux": "4.2.1",
    "styled-components": "6.1.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.13.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "6.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.6",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "maplibre-gl": "6.11.2"
  }
}
